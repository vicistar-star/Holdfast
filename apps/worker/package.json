{
  "name": "@holdfast/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-strip-types src/index.ts",
    "backfill": "node --experimental-strip-types src/backfill.ts",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@holdfast/contract-client": "workspace:*",
    "@holdfast/db": "workspace:*",
    "@holdfast/shared": "workspace:*",
    "bullmq": "5.53.2",
    "ioredis": "5.6.1"
  },
  "devDependencies": {
    "@types/node": "22.15.17",
    "typescript": "5.8.3"
  }
}
