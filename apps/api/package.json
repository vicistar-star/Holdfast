{
  "name": "@holdfast/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@holdfast/db": "workspace:*",
    "@holdfast/shared": "workspace:*",
    "fastify": "5.3.2",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@types/node": "22.15.17",
    "typescript": "5.8.3"
  }
}
