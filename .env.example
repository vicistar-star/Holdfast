# =============================================================================
# Holdfast — environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://holdfast:holdfast@localhost:5432/holdfast

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Stellar / Soroban
# -----------------------------------------------------------------------------
# "testnet" or "mainnet"
STELLAR_NETWORK=testnet

# Soroban RPC endpoint for the chosen network
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase — must match STELLAR_NETWORK
# Testnet:  "Test SDF Network ; September 2015"
# Mainnet:  "Public Global Stellar Network ; September 2015"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Deployed escrow contract ID (set after running scripts/deploy-testnet.sh)
ESCROW_CONTRACT_ID=

# Token contract for the settlement asset — required for Mode B/C only
USDC_ASSET_CONTRACT_ID=

# -----------------------------------------------------------------------------
# Escrow mode
# "A" = local-currency rails, partner holds funds, contract is state+reputation layer (v1 default)
# "B" = on-chain USDC escrow via Soroban contract (testnet only until audited)
# -----------------------------------------------------------------------------
ESCROW_MODE=A

# -----------------------------------------------------------------------------
# Sponsor / fee service
# The sponsor pays Stellar fees and base reserves on behalf of users.
# In production the key must live in a KMS or HSM — never in an env file.
# -----------------------------------------------------------------------------

# PRODUCTION: KMS reference for the sponsor key (e.g. AWS KMS key ARN)
SPONSOR_KMS_KEY_ID=

# LOCAL DEV ONLY — plain secret key for the sponsor account.
# Replace with KMS in staging and production. NEVER use in production.
SPONSOR_SECRET=

# -----------------------------------------------------------------------------
# Keeper worker
# Submits permissionless timeout calls (claim_refund, claim_auto_release).
# LOCAL DEV ONLY — plain secret key. Replace with KMS in staging/production.
# NEVER use in production.
# -----------------------------------------------------------------------------
KEEPER_SECRET=

# -----------------------------------------------------------------------------
# Payment partner
# The adapter to load (e.g. "paystack", "flutterwave", "mock")
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_KEY=
# HMAC secret used to verify incoming webhooks from the payment partner
PAYMENT_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# KYC provider
# -----------------------------------------------------------------------------
KYC_PROVIDER_KEY=

# -----------------------------------------------------------------------------
# Messaging
# WhatsApp Business API bearer token
WHATSAPP_TOKEN=
# SMS provider API key (e.g. Termii, Africa's Talking)
SMS_API_KEY=

# -----------------------------------------------------------------------------
# Object / evidence storage (S3-compatible)
# In local dev with MinIO in docker-compose, use:
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_KEY=holdfast
# STORAGE_SECRET=holdfastpassword
# -----------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=holdfast-evidence
STORAGE_KEY=holdfast
STORAGE_SECRET=holdfastpassword
STORAGE_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Arbiter signing key (Mode B resolve_dispute on testnet)
# LOCAL DEV ONLY — plain secret key. Production must use a hardware multisig.
# -----------------------------------------------------------------------------
ARBITER_SECRET=

# -----------------------------------------------------------------------------
# Auth & Dev aids
# Long random string used to sign JWT access tokens.
# LOCAL DEV ONLY — generate a real secret and keep it in a secret manager.
# NEVER commit a real value here.
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-in-production
# In local dev/tests, echo generated OTP in the API response for automated testing
OTP_DEV_ECHO=true

# -----------------------------------------------------------------------------
# Business rules
# Both values are integers. Order amounts are in the currency's minor unit (kobo for NGN).
# -----------------------------------------------------------------------------
# Maximum allowed amount per order in minor units (e.g. 5000000 = ₦50,000 at kobo precision)
MAX_ORDER_AMOUNT_MINOR=5000000
# Platform fee in basis points (100 = 1%). Capped in contract code at 500 (5%).
FEE_BPS=100
# Threshold in minor units above which an arbiter dispute resolution flags second-approver required (₦1,000,000)
SECOND_APPROVER_THRESHOLD_MINOR=100000000
# Margin in seconds after ship_by or review_ends before the keeper emits an overdue alert (default: 15 mins)
KEEPER_ALERT_MARGIN_SECS=900
